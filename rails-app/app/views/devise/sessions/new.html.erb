<% content_for :title, "Entrar" %>

<div class="auth-wrap">
  <div class="card auth-card">
    <div class="auth-logo">📝</div>
    <h1>Entrar</h1>
    <p class="auth-sub">Acesse sua lista de tarefas</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field">
        <%= f.label :email, "E-mail" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
      </div>

      <div class="field">
        <%= f.label :password, "Senha" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field check-field remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Lembrar de mim" %>
        </div>
      <% end %>

      <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
    <%= link_to "← Voltar para a página inicial", root_path, class: "auth-back" %>
  </div>
</div>
