<% content_for :title, "Criar conta" %>

<div class="auth-wrap">
  <div class="card auth-card">
    <div class="auth-logo">📝</div>
    <h1>Criar conta</h1>
    <p class="auth-sub">Comece a organizar suas tarefas</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, "E-mail" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
      </div>

      <div class="field">
        <%= f.label :password, "Senha" %>
        <% if @minimum_password_length %>
          <em class="hint">(mínimo de <%= @minimum_password_length %> caracteres)</em>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", required: true, minlength: @minimum_password_length %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirmar senha" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
      </div>

      <%= f.submit "Criar conta", class: "btn btn-primary btn-block" %>
    <% end %>

    <div class="auth-links">
      <%= render "devise/shared/links" %>
    </div>
    <%= link_to "← Voltar para a página inicial", root_path, class: "auth-back" %>
  </div>
</div>
