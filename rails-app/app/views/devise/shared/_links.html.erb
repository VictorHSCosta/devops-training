<%- if controller_name != "sessions" %>
  <%= link_to "Já tenho conta — Entrar", new_session_path(resource_name) %>
<% end %>
<%- if devise_mapping.registerable? && controller_name != "registrations" %>
  <%= link_to "Criar uma conta", new_registration_path(resource_name) %>
<% end %>
<%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
  <%# ponytail: recuperação de senha desabilitada na UI — mailer não configurado; habilitar quando SMTP existir %>
<% end %>
